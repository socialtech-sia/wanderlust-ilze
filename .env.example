# Копия этого файла с реальными значениями лежит на сервере: /opt/wanderlust/.env (chmod 600).
# В git не коммитится. Локально: cp .env.example .env и подставьте значения.
#
# ЗНАЧЕНИЯ БЕЗ КАВЫЧЕК. `docker --env-file` кавычки не снимает, и в контейнер
# приедет строка вместе с ними: страница отрендерится, но без данных из Supabase.

NODE_ENV=production
PORT=3000

# Supabase (управляемый проект, НЕ локальный демо-стек на этой машине).
# URL и publishable/anon-ключ публичны по устройству Supabase: доступ ограничивает RLS.
# VITE_* нужны на этапе СБОРКИ — они вшиваются в клиентский бандл (deploy/Dockerfile).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=<project-ref>
# Те же значения для SSR — их читает серверный код через process.env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=<project-ref>

# Секретный ключ Supabase. Нужен только серверным ручкам администратора
# (src/integrations/supabase/client.server.ts). В клиентский бандл не попадает и
# не должен: префикса VITE_ у него нет намеренно.
SUPABASE_SERVICE_ROLE_KEY=

# Строка подключения к базе управляемого Supabase (Project Settings -> Database ->
# Connection string -> URI), с паролем. Нужна ТОЛЬКО скрипту бэкапа и ручным
# миграциям; приложению — нет, оно ходит через REST. Без неё deploy/backup.sh
# останавливается, то есть ежедневного бэкапа (пункт договора 6.8) не существует.
SUPABASE_DB_URL=

# Офсайт-копия бэкапа. Пока пусто — дамп лежит только на этой машине.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Публичный адрес сайта — из него собираются ссылки в письмах и sitemap.
SITE_URL=https://wanderlust.lv

# Почта уведомлений (пункт договора 4.3). Без ключа форма отработает,
# но письмо не уйдёт — см. src/routes/api/public/*-notification.ts.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Чат-бот (пункт договора 5.5). Без ключа ручка /api/public/chat вернёт ошибку.
ANTHROPIC_API_KEY=
